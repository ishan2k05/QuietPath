# ==========================================
# QuietPath Root .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
serviceAccountKey.json

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------
# IDEs and Editors
# ------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / Android Studio / PyCharm
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# Python / Backend
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging & builds
develop-eggs/
dist/
downloads/
eggs/
.eggs/
backend/lib/
backend/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.pytype/
.ruff_cache/

# ------------------------------------------
# Database
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump
*.sql.gz

# ------------------------------------------
# Flutter / Dart / Mobile
# ------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
**/coverage/
**/doc/api/
.widget_preview/
quietpath_config.json
*.apk
*.aab

# Ensure Flutter source code is never ignored
!**/mobile/**/lib/
!**/mobile/**/lib/**

# Android build & local artifacts
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.keystore
*.jks

# iOS build & local artifacts
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/App.framework
**/ios/DerivedData/

# Obfuscation & symbols
app.*.symbols
app.*.map.json

# ------------------------------------------
# Logs and Temporary Files
# ------------------------------------------
*.log
*.tmp
*.temp
temp/
tmp/
